+// DAV HACK
+//============================================================
+//  slot_key_pressed - is a lone joystick button being held,
+//  i.e. one this menu could turn into a slot name? START is
+//  the modifier for the UI combos, so while it is down this
+//  says no and the combo goes through untouched.
+//============================================================
+
+bool menu_load_save_state_base::slot_key_pressed() const
+{
+	input_class const &sticks = machine().input().device_class(DEVICE_CLASS_JOYSTICK);
+	if (!sticks.enabled())
+		return false;
+
+	bool found = false;
+	for (int i = 0; sticks.maxindex() >= i; ++i)
+	{
+		input_device const *const stick = sticks.device(i);
+		if (!stick)
+			continue;
+
+		for (input_item_id j : { ITEM_ID_START, ITEM_ID_SELECT })
+		{
+			if (stick->maxitem() < j)
+				continue;
+			input_device_item const *const item = stick->item(j);
+			if (item && machine().input().code_pressed(item->code()))
+				return false;
+		}
+
+		for (input_item_id j = ITEM_ID_BUTTON1; (ITEM_ID_BUTTON32 >= j) && (stick->maxitem() >= j); ++j)
+		{
+			input_device_item const *const item = stick->item(j);
+			if (item && (item->itemclass() == ITEM_CLASS_SWITCH) && machine().input().code_pressed(item->code()))
+				found = true;
+		}
+	}
+	return found;
+}
+// DAV HACK end
+
